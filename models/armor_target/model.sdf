<?xml version="1.0" ?>
<sdf version="1.8">
  <!-- 自瞄专用静态装甲板靶标 (带真实贴纸与发光灯条) -->
  <model name="armor_target">
    <static>true</static>  <!-- 固定在地面，不会倒 -->
    <pose>0 0 0 0 0 0</pose>

    <!-- 1. 底座立柱 (高度约 0.35m，与真实装甲板离地高度一致) -->
    <link name="base_link">
      <visual name="stand_visual">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="stand_collision">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- 2. 装甲板与发光灯条 -->
    <joint name="armor_joint" type="fixed">
      <pose relative_to="base_link">0.05 0 0.35 0 0 0</pose>
      <parent>base_link</parent>
      <child>armor_link</child>
    </joint>

    <link name="armor_link">
      <pose relative_to="armor_joint">0 0 0 0 0 0</pose>

      <!-- 装甲板黑色外壳 -->
      <visual name="armor_shell">
        <geometry>
          <mesh>
            <uri>model://rm21_armor_module/meshes/small_armor.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- 中间黑色受击靶面 -->
      <visual name="target_visual">
        <geometry>
          <mesh>
            <uri>model://rm21_armor_module/meshes/small_armor_target.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <!-- 两侧发光灯条 -->
      <visual name="light_bar_visual">
        <geometry>
          <mesh>
            <uri>model://rm21_armor_module/meshes/small_armor_light_bar.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- 数字 1 号装甲板贴纸 -->
      <visual name="sticker_visual">
        <pose>0.014 0 0.0625 1.5708 0 1.5708</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.130 0.120</size>
          </plane>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://rm22_armor_module/materials/textures/ua_num1_0.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="armor_collision">
        <pose>0 0 0.0625 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.14 0.13</size>
          </box>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>
